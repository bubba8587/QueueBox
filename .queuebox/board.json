    {
      "id": "decisions",
      "name": "Decision tree",
      "district": "repo",
      "about": "The DTE decision tree (decisions/), the specs under it, the vendored DTE tool and its config, and CLAUDE.md. Never edit vendor/dte/ or tools/dte.py here: refresh them from the DTE repository.",
      "paths": [
        "decisions/",
        "specs/",
        "vendor/dte/",
        "tools/",
        "dte.cfg",
        ".dteignore",
        ".dtecoverage",
        "CLAUDE.md"
      ],
      "docs": [
        "CLAUDE.md",
        "vendor/dte/PROTOCOL.md"
      ],
      "keywords": [
        "decision",
        "leaf",
        "ring",
        "spec",
        "dte",
        "ratify"
      ]
    }
