    {
      "id": "docs",
      "name": "Docs and config",
      "district": "repo",
      "about": "README, package.json, examples, the board itself.",
      "paths": [
        "README.md",
        "package.json",
        ".gitignore",
        "examples/",
        ".queuebox/board.json",
        "LICENSE",
        ".queuebox/.gitignore"
