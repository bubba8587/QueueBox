      "about": "Inbox, agent windows, worktree strip, merge queue, block drawer, timeline.",
      "paths": [
        "ui/windows.js",
        "ui/inspector.js",
        "ui/worktrees.js",
        "ui/timeline.js",
        "ui/popover.js",
        "ui/itemview.js"
      ],
      "docs": [
        "README.md"
      ],
      "keywords": [
        "inbox",
        "window",
        "drawer",
        "inspector",
        "timeline",
        "worktree strip"
      ]
    },
    {
      "id": "shell",
