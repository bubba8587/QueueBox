        "ui/styles.css",
        "ui/dom.js",
        "ui/source.js",
        "ui/fonts/",
        "ui/favicon.js",
        "ui/newitem.js",
        "ui/help.js"
      ],
      "docs": [
        "README.md"
      ],
      "keywords": [
        "app",
        "styles",
        "sim"
      ]
