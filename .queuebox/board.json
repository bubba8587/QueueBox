{
  "schema": 1,
  "name": "QueueBox",
  "human": {
    "name": "Author"
  },
  "staleAfterMin": 30,
  "guard": {
    "held": "deny",
    "frozen": "deny",
    "free": "reserve"
  },
  "districts": [
    {
      "id": "page",
      "name": "Page"
    },
    {
      "id": "engine",
      "name": "Engine"
    },
    {
      "id": "agents",
      "name": "Agent side"
    },
    {
      "id": "repo",
      "name": "Repository"
    }
  ],
  "blocks": [
